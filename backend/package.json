{
  "name": "subasta-backend",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && esbuild src/app.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/app.js --external:pg-native",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/db/runMigrations.ts",
    "create-admin": "tsx src/db/createAdmin.ts",
    "seed": "tsx src/db/seed.ts",
    "cleanup": "tsx src/db/cleanup.ts",
    "setup-db": "npm run migrate && npm run seed"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.5",
    "apify-client": "^2.23.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^3.12.7",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.5",
    "qs": "^6.17.1",
    "zod": "^4.6.7"
  }
}
