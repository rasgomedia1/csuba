DATABASE_URL=postgresql://subasta:subasta@localhost:5432/subasta_db
# Obligatorio, minimo 16 caracteres (el servidor no arranca sin el)
JWT_SECRET=cambia_esto_por_un_secreto_largo
PORT=3000
NODE_ENV=development

# Apify Integration for BOE Scraping
APIFY_API_KEY=your_apify_api_key_here
APIFY_ACTOR_ID=olican/spain-subastas-boe-catastro
# Background auto-sync on every search. Set to true to enable calling the Apify
# actor to refresh BOE data (requires available Apify credits).
APIFY_SYNC_ENABLED=false

# Token de los endpoints de administracion /api/scrapers (cabecera x-admin-token).
# Sin el, esos endpoints quedan desactivados (503).
ADMIN_TOKEN=
# Log de cada consulta SQL (solo depuracion)
LOG_QUERIES=false
